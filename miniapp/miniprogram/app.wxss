/** app.wxss **/
page {
  --primary-color: #5D87FF;
  --primary-gradient: linear-gradient(135deg, #5D87FF 0%, #4A6CF7 100%);
  --color-success: #34C759;
  --color-warning: #FF9F0A;
  --color-danger: #FF3B30;
  --color-bg-page: #FAFAFA;
  --color-bg-card: rgba(255, 255, 255, 0.8);
  --color-bg-input: rgba(255, 255, 255, 0.9);
  --color-text-main: #1D1D1F;
  --color-text-regular: #666666;
  --color-text-minor: #8E8E93;
  --color-border: rgba(0, 0, 0, 0.05);

  background-color: var(--color-bg-page);
  color: var(--color-text-main);
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", Helvetica, Arial, sans-serif;
  font-size: 28rpx;
  box-sizing: border-box;
}

view, text, scroll-view, swiper, button, form, input, textarea, label, navigator, image {
  box-sizing: border-box;
}

.container {
  min-height: 100vh;
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}

.pb-space {
  padding-bottom: 120rpx;
}

/* 常用卡片 */
.card {
  background-color: var(--color-bg-card);
  border-radius: 40rpx;
  padding: 32rpx;
  margin: 32rpx 48rpx;
  box-shadow: 0 16rpx 48rpx -16rpx rgba(0, 0, 0, 0.06);
  border: 2rpx solid rgba(255, 255, 255, 0.5);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
}

/* Apple 风格按钮 */
.btn-primary {
  width: auto !important;
  height: 96rpx;
  line-height: 96rpx;
  background: var(--primary-gradient);
  color: #ffffff;
  border-radius: 24rpx;
  font-size: 34rpx;
  font-weight: 600;
  padding: 0 48rpx;
  box-shadow: 0 16rpx 32rpx rgba(93, 135, 255, 0.3);
  transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  text-align: center;
}
.btn-primary:active {
  transform: scale(0.96);
  opacity: 0.8;
  box-shadow: 0 8rpx 16rpx rgba(93, 135, 255, 0.2);
}
.btn-primary[disabled] {
  background: #F2F2F7 !important;
  color: #C7C7CC !important;
  box-shadow: none !important;
}

.card-title {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
  color: var(--color-text-main);
}

/* 常用布局 */
.flex-row {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.flex-col {
  display: flex;
  flex-direction: column;
}

.justify-between {
  justify-content: space-between;
}

.justify-center {
  justify-content: center;
}

/* 常用文本 */
.text-bold {
  font-weight: bold;
}
.text-muted {
  color: var(--color-text-minor);
}
.text-primary {
  color: var(--primary-color);
}
.text-success {
  color: var(--color-success);
}
.text-warning {
  color: var(--color-warning);
}
.text-danger {
  color: var(--color-danger);
}
.text-sm {
  font-size: 24rpx;
}
.text-md {
  font-size: 28rpx;
}
.text-lg {
  font-size: 32rpx;
}
.text-xl {
  font-size: 36rpx;
}

/* 徽标/标签 */
.badge {
  display: inline-block;
  padding: 4rpx 12rpx;
  font-size: 20rpx;
  border-radius: 8rpx;
  background: var(--color-bg-page);
  color: var(--color-text-regular);
}
.badge-blue {
  background: rgba(41, 121, 255, 0.1);
  color: var(--primary-color);
}
.badge-red {
  background: rgba(250, 53, 52, 0.1);
  color: var(--color-danger);
}
.badge-green {
  background: rgba(24, 181, 102, 0.1);
  color: var(--color-success);
}
.badge-orange {
  background: rgba(255, 158, 15, 0.1);
  color: var(--color-warning);
}

/* 按钮重置 */
.btn {
  /* ... */
}

/* 兼容SVG和Emoji替换 */
.css-icon {
  display: inline-block;
  width: 48rpx;
  height: 48rpx;
  background-size: contain;
  background-repeat: no-repeat;
  background-position: center;
  vertical-align: middle;
}

