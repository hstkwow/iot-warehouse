page {
  background-color: #F4F5F9;
}

.dashboard-container {
  min-height: 100vh;
  position: relative;
  overflow: hidden;
  box-sizing: border-box;
}

/* Glassmorphism Background Circles */
.bg-blur-circle {
  position: absolute;
  border-radius: 50%;
  filter: blur(140rpx);
  opacity: 0.5;
  z-index: 0;
  pointer-events: none;
}
.bg-azure {
  width: 500rpx;
  height: 500rpx;
  background: #E0F2FE;
  top: -100rpx;
  left: -100rpx;
}
.bg-teal {
  width: 400rpx;
  height: 400rpx;
  background: #CCFBF1;
  top: 150rpx;
  right: -50rpx;
}

/* Custom Navigation */
.custom-nav-wrap {
  position: relative;
  z-index: 10;
  background: rgba(244, 245, 249, 0.7);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  padding-bottom: 8rpx;
}
.custom-nav {
  display: flex;
  align-items: center;
  height: 88rpx;
  padding: 0 16rpx;
  position: relative;
}
.nav-left {
  display: flex;
  align-items: center;
  color: #007AFF;
  padding: 10rpx 0;
}
.nav-back-text {
  font-size: 34rpx;
  font-weight: 400;
  margin-left: -6rpx;
}
.nav-title {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  font-size: 34rpx;
  font-weight: 600;
  color: #000;
}

/* Content */
.content-scroll {
  position: relative;
  z-index: 1;
  width: 100%;
  box-sizing: border-box;
  padding: 24rpx 10rpx;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

.card {
  background: rgba(255, 255, 255, 0.6);
  backdrop-filter: blur(40px);
  -webkit-backdrop-filter: blur(40px);
  border: 1px solid rgba(255, 255, 255, 0.8);
  border-radius: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.04);
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-sizing: border-box;
}

/* Profile Card - Apple Style */
.profile-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 20rpx;
  background: var(--apple-card-bg);
  backdrop-filter: blur(20px);
}
.profile-img-wrap {
  position: relative;
  width: 240rpx;
  height: 240rpx;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.1);
  margin-bottom: 24rpx;
}
.apple-hover-img {
  opacity: 0.8;
}
.profile-img {
  width: 100%;
  height: 100%;
  background-color: var(--apple-bg-color);
  object-fit: cover;
}
.profile-img.no-img {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #999;
  font-size: 28rpx;
  background-color: #E5E5EA;
}
.edit-text {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: rgba(0,0,0,0.5);
  color: white;
  text-align: center;
  font-size: 22rpx;
  padding: 8rpx 0;
  backdrop-filter: blur(4px);
}
.profile-info {
  text-align: center;
}
.profile-title {
  font-size: 40rpx;
  font-weight: 600;
  color: var(--apple-text-color);
  margin-bottom: 8rpx;
}
.profile-code {
  font-size: 26rpx;
  color: #8E8E93;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1c1c1e;
  margin: 40rpx 0 24rpx 12rpx;
}

/* Apple Form Group Settings */
.apple-form-group {
  padding: 0 !important;
  display: flex;
  flex-direction: column;
}

.apple-form-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 100rpx;
  padding: 24rpx 32rpx;
  background: transparent;
  position: relative;
}

.apple-form-item:not(.no-border)::after {
  content: "";
  position: absolute;
  left: 32rpx;
  right: 0;
  bottom: 0;
  height: 1rpx;
  background: rgba(0, 0, 0, 0.05);
}

.apple-hover {
  background: rgba(0, 0, 0, 0.05);
}

.apple-form-item .label {
  font-size: 32rpx;
  color: #1C1C1E;
  width: 220rpx;
  flex-shrink: 0;
}

.apple-form-item .value-input {
  flex: 1;
  text-align: right;
  font-size: 32rpx;
  color: #1C1C1E;
}

.apple-form-item .value-text {
  flex: 1;
  text-align: right;
  font-size: 32rpx;
}

.apple-form-item .value-text.no-value {
  color: #C7C7CC;
}

.apple-form-item .value-text.has-value {
  color: #1C1C1E;
}

.apple-form-item .read-only {
  color: #8E8E93;
}

.apple-placeholder {
  color: #C7C7CC;
}

.apple-form-item .arrow {
  margin-left: 12rpx;
}

.action-bar {
  display: flex;
  flex-direction: row;
  justify-content: center;
  gap: 24rpx;
  margin: 40rpx 24rpx 0 24rpx;
}

.apple-btn {
  flex: 1;
  max-width: 200rpx;
  height: 84rpx;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: opacity 0.2s;
  box-sizing: border-box;
}

.apple-btn-hover {
  opacity: 0.7;
}

.apple-btn.primary {
  background-color: #007AFF;
  color: #FFFFFF;
}

.apple-btn.secondary {
  background-color: #FFFFFF;
  color: #007AFF;
  border: 1rpx solid rgba(0, 122, 255, 0.2);
}

.apple-btn.danger {
  background-color: #FFFFFF;
  color: #FF3B30;
  border: 1rpx solid rgba(255, 59, 48, 0.2);
}

.bottom-pad {
  height: 80rpx;
}

/* Bottom Popup Settings */
.popup-wrapper {
  background: #F2F2F7;
  border-radius: 24rpx 24rpx 0 0;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  max-height: 80vh;
}

.popup-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx;
  background: #FFFFFF;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.05);
}

.popup-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #1c1c1e;
}

.popup-close {
  color: #8E8E93;
}

.popup-content {
  flex: 1;
  padding: 24rpx;
  box-sizing: border-box;
}

.popup-form {
  background: #FFFFFF;
  margin-bottom: 0;
}

.apple-form-item.last-item::after {
  display: none;
}

.popup-footer {
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background: #FFFFFF;
  border-top: 1rpx solid rgba(0, 0, 0, 0.05);
}

.apple-btn.block {
  max-width: 100%;
  width: 100%;
}

/* Write Card Popup Adjustments */
.rfid-popup-scroll {
  padding: 0;
  background-color: #F2F2F7;
}

.rfid-info-card {
  margin: 24rpx;
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 24rpx;
}

.info-row {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}
.info-row:last-child {
  margin-bottom: 0;
}

.info-label {
  font-size: 28rpx;
  color: #8E8E93;
  width: 140rpx;
  flex-shrink: 0;
}

.info-value {
  font-size: 28rpx;
  color: #1C1C1E;
  flex: 1;
}

.info-value.text-right {
  text-align: right;
  padding-right: 12rpx;
}

.popup-form {
  margin: 0 24rpx 24rpx 24rpx !important;
  border-radius: 20rpx;
  overflow: hidden;
}

.rfid-preview {
  margin: 0 24rpx 32rpx 24rpx;
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 24rpx;
  display: flex;
  flex-direction: column;
}

.preview-title {
  font-size: 28rpx;
  color: #8E8E93;
  margin-bottom: 12rpx;
}

.preview-content {
  font-size: 34rpx;
  font-weight: 600;
  color: #007AFF;
  letter-spacing: 2rpx;
  word-break: break-all;
}
