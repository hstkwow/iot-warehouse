page {
  background-color: #F2F2F7;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", Helvetica, Segoe UI, Arial, sans-serif;
}

.container {
  min-height: 100vh;
  position: relative;
  padding-bottom: env(safe-area-inset-bottom);
  box-sizing: border-box;
}

/* 动态背景模糊圆点效果 */
.bg-blur-circle {
  position: fixed;
  border-radius: 50%;
  filter: blur(80px);
  z-index: 0;
  pointer-events: none;
  opacity: 0.6;
}
.bg-blue {
  width: 600rpx;
  height: 600rpx;
  background: rgba(0, 122, 255, 0.15);
  top: -100rpx;
  right: -200rpx;
}
.bg-green {
  width: 500rpx;
  height: 500rpx;
  background: rgba(52, 199, 89, 0.15);
  bottom: 200rpx;
  left: -150rpx;
}
.bg-orange {
  width: 500rpx;
  height: 500rpx;
  background: rgba(255, 149, 0, 0.15);
  bottom: 200rpx;
  left: -150rpx;
}

/* 内容滚动区 */
.content-scroll {
  position: relative;
  z-index: 1;
  padding: 0 32rpx 60rpx;
}

/* 顶部状态卡 */
.header-card {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 64rpx 0 48rpx;
}

.header-icon-wrap {
  width: 144rpx;
  height: 144rpx;
  border-radius: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 32rpx;
}

.header-type {
  font-size: 44rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.header-time {
  font-size: 28rpx;
  color: #8E8E93;
}

/* 详情区块 */
.section {
  margin-bottom: 36rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #8E8E93;
  margin-bottom: 16rpx;
  padding-left: 12rpx;
}

.glass-card {
  background: rgba(255, 255, 255, 0.7);
  border-radius: 32rpx;
  padding: 8rpx 32rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.04);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 1px solid rgba(255, 255, 255, 0.8);
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 26rpx 0;
  min-height: 48rpx;
}

.label {
  font-size: 30rpx;
  color: #1C1C1E;
  flex-shrink: 0;
}

.value {
  font-size: 30rpx;
  color: #8E8E93;
  text-align: right;
  flex: 1;
  word-break: break-all;
  margin-left: 40rpx;
}

.highlight {
  color: #007AFF;
  font-weight: 500;
}

.text-mono {
  font-family: monospace;
}

.divider {
  height: 1rpx;
  background: rgba(0, 0, 0, 0.05);
  width: 100%;
}

.detail-footer {
  text-align: center;
  margin-top: 60rpx;
  padding-bottom: 40rpx;
}

.text-muted {
  color: #C7C7CC;
  font-size: 24rpx;
}
