<view style="padding: 32rpx; padding-bottom: calc(180rpx + env(safe-area-inset-bottom));">
  
  <view style="font-size: 26rpx; color: #FF3B30; text-align: center; margin-bottom: 32rpx; padding: 16rpx; background: rgba(255,59,48,0.08); border-radius: 16rpx;" wx:if="{{status !== 1}}">
    <t-icon name="error-circle" size="28rpx" style="vertical-align: middle; margin-right: 6rpx;"/> 设备当前离线，无法下发配置参数
  </view>

  <view wx:if="{{loading}}" style="display: flex; justify-content: center; padding: 100rpx 0;">
    <t-loading theme="circular" size="48rpx" text="读取云端配置中..." />
  </view>
  
  <view wx:else>
    <!-- 基础配置 -->
    <view style="margin-bottom: 48rpx;">
      <view style="font-size: 26rpx; font-weight: 500; color: #8E8E93; margin-bottom: 16rpx; padding-left: 32rpx; text-transform: uppercase;">
        系统控制状态
      </view>
      <view style="background: #FFFFFF; border-radius: 20rpx; padding: 0 0 0 32rpx;">
        
        <!-- 工作模式 -->
        <view style="display: flex; justify-content: space-between; align-items: center; padding: 28rpx 32rpx 28rpx 0; border-bottom: 1px solid rgba(0,0,0,0.05);">
          <view style="font-size: 32rpx; font-weight: 400; color: #000;">工作模式</view>
          <view style="display: flex; background: #EEEFF0; border-radius: 14rpx; padding: 4rpx; width: 300rpx;">
            <view bindtap="onSegmentChange" data-field="workMode" data-value="inbound" style="flex: 1; text-align: center; font-size: 26rpx; padding: 10rpx 0; border-radius: 10rpx; transition: all 0.2s; {{configForm.workMode === 'inbound' ? 'background: #FFF; font-weight: 600; color: #000; box-shadow: 0 4rpx 10rpx rgba(0,0,0,0.12);' : 'color: #8E8E93;'}}">
              入库
            </view>
            <view bindtap="onSegmentChange" data-field="workMode" data-value="outbound" style="flex: 1; text-align: center; font-size: 26rpx; padding: 10rpx 0; border-radius: 10rpx; transition: all 0.2s; {{configForm.workMode === 'outbound' ? 'background: #FFF; font-weight: 600; color: #000; box-shadow: 0 4rpx 10rpx rgba(0,0,0,0.12);' : 'color: #8E8E93;'}}">
              出库
            </view>
          </view>
        </view>

        <!-- 告警模式 -->
        <view style="display: flex; justify-content: space-between; align-items: center; padding: 28rpx 32rpx 28rpx 0;">
          <view style="font-size: 32rpx; font-weight: 400; color: #000;">告警模式</view>
          <view style="display: flex; background: #EEEFF0; border-radius: 14rpx; padding: 4rpx; width: 300rpx;">
            <view bindtap="onSegmentChange" data-field="alarmMode" data-value="auto" style="flex: 1; text-align: center; font-size: 26rpx; padding: 10rpx 0; border-radius: 10rpx; transition: all 0.2s; {{configForm.alarmMode === 'auto' ? 'background: #FFF; font-weight: 600; color: #000; box-shadow: 0 4rpx 10rpx rgba(0,0,0,0.12);' : 'color: #8E8E93;'}}">
              自动
            </view>
            <view bindtap="onSegmentChange" data-field="alarmMode" data-value="manual" style="flex: 1; text-align: center; font-size: 26rpx; padding: 10rpx 0; border-radius: 10rpx; transition: all 0.2s; {{configForm.alarmMode === 'manual' ? 'background: #FFF; font-weight: 600; color: #000; box-shadow: 0 4rpx 10rpx rgba(0,0,0,0.12);' : 'color: #8E8E93;'}}">
              手动
            </view>
          </view>
        </view>

      </view>
    </view>

    <!-- 环境与安防报警阈值 -->
    <view style="margin-bottom: 48rpx;">
      <view style="font-size: 26rpx; font-weight: 500; color: #8E8E93; margin-bottom: 16rpx; padding-left: 32rpx; text-transform: uppercase;">
        安防与环境控制阈值
      </view>
      <view style="background: #FFFFFF; border-radius: 20rpx; padding: 0 0 0 32rpx;">
        
        <!-- 目标温度 -->
        <view style="padding: 32rpx 32rpx 32rpx 0; border-bottom: 1px solid rgba(0,0,0,0.05);">
          <view style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 32rpx;">
            <text style="font-size: 32rpx; font-weight: 400; color: #000;">目标温度 (℃)</text>
            <text style="font-size: 32rpx; font-weight: 500; color: #007AFF;">{{configForm.tempMin}} ~ {{configForm.tempMax}}</text>
          </view>
          <view style="display: flex; align-items: center;">
            <t-slider range value="{{[configForm.tempMin, configForm.tempMax]}}" min="-40" max="80" label="{{false}}" bind:change="onConfigRangeChange" data-minfield="tempMin" data-maxfield="tempMax" style="flex: 1; --td-slider-bar-height: 6rpx; --td-slider-thumb-size: 40rpx; --td-slider-active-color: #007AFF; --td-slider-track-color: #EEEFF0;"/>
          </view>
        </view>

        <!-- 环境湿度 -->
        <view style="padding: 32rpx 32rpx 32rpx 0; border-bottom: 1px solid rgba(0,0,0,0.05);">
          <view style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 32rpx;">
            <text style="font-size: 32rpx; font-weight: 400; color: #000;">环境湿度上限 (%)</text>
            <text style="font-size: 32rpx; font-weight: 500; color: #32ADE6;">{{configForm.humidityMax}}</text>
          </view>
          <view style="display: flex; align-items: center;">
            <t-slider value="{{configForm.humidityMax}}" min="0" max="100" label="{{false}}" bind:change="onConfigSliderChange" data-field="humidityMax" style="flex: 1; --td-slider-bar-height: 6rpx; --td-slider-thumb-size: 40rpx; --td-slider-active-color: #32ADE6; --td-slider-track-color: #EEEFF0;"/>
          </view>
        </view>

        <!-- 光照度区间 -->
        <view style="padding: 32rpx 32rpx 32rpx 0; border-bottom: 1px solid rgba(0,0,0,0.05);">
          <view style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 32rpx;">
            <text style="font-size: 32rpx; font-weight: 400; color: #000;">光照度区间 (Lux)</text>
            <text style="font-size: 32rpx; font-weight: 500; color: #FFCC00;">{{configForm.lightMin}} ~ {{configForm.luxMax}}</text>
          </view>
          <view style="display: flex; align-items: center;">
            <t-slider range value="{{[configForm.lightMin, configForm.luxMax]}}" min="0" max="65535" label="{{false}}" bind:change="onConfigRangeChange" data-minfield="lightMin" data-maxfield="luxMax" style="flex: 1; --td-slider-bar-height: 6rpx; --td-slider-thumb-size: 40rpx; --td-slider-active-color: #FFCC00; --td-slider-track-color: #EEEFF0;"/>
          </view>
        </view>

        <!-- 有害气体 -->
        <view style="padding: 32rpx 32rpx 32rpx 0; border-bottom: 1px solid rgba(0,0,0,0.05);">
          <view style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 32rpx;">
            <text style="font-size: 32rpx; font-weight: 400; color: #000;">有害气体上限 (PPM)</text>
            <text style="font-size: 32rpx; font-weight: 500; color: #5856D6;">{{configForm.gasMax}}</text>
          </view>
          <view style="display: flex; align-items: center;">
            <t-slider value="{{configForm.gasMax}}" min="0" max="10000" step="50" label="{{false}}" bind:change="onConfigSliderChange" data-field="gasMax" style="flex: 1; --td-slider-bar-height: 6rpx; --td-slider-thumb-size: 40rpx; --td-slider-active-color: #5856D6; --td-slider-track-color: #EEEFF0;"/>
          </view>
        </view>

        <!-- 烟雾颗粒 -->
        <view style="padding: 32rpx 32rpx 32rpx 0; border-bottom: 1px solid rgba(0,0,0,0.05);">
          <view style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 32rpx;">
            <text style="font-size: 32rpx; font-weight: 400; color: #000;">烟雾颗粒上限 (PPM)</text>
            <text style="font-size: 32rpx; font-weight: 500; color: #FF3B30;">{{configForm.smokeThreshold}}</text>
          </view>
          <view style="display: flex; align-items: center;">
            <t-slider value="{{configForm.smokeThreshold}}" min="0" max="10000" step="50" label="{{false}}" bind:change="onConfigSliderChange" data-field="smokeThreshold" style="flex: 1; --td-slider-bar-height: 6rpx; --td-slider-thumb-size: 40rpx; --td-slider-active-color: #FF3B30; --td-slider-track-color: #EEEFF0;"/>
          </view>
        </view>

        <!-- 气压异常 -->
        <view style="padding: 32rpx 32rpx 32rpx 0; border-bottom: 1px solid rgba(0,0,0,0.05);">
          <view style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 32rpx;">
            <text style="font-size: 32rpx; font-weight: 400; color: #000;">气压异常上限 (hPa)</text>
            <text style="font-size: 32rpx; font-weight: 500; color: #34C759;">{{configForm.pressureMax}}</text>
          </view>
          <view style="display: flex; align-items: center;">
            <t-slider value="{{configForm.pressureMax}}" min="300" max="1200" step="10" label="{{false}}" bind:change="onConfigSliderChange" data-field="pressureMax" style="flex: 1; --td-slider-bar-height: 6rpx; --td-slider-thumb-size: 40rpx; --td-slider-active-color: #34C759; --td-slider-track-color: #EEEFF0;"/>
          </view>
        </view>

        <!-- 露点预警 -->
        <view style="padding: 32rpx 32rpx 32rpx 0;">
          <view style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 32rpx;">
            <text style="font-size: 32rpx; font-weight: 400; color: #000;">露点凝结预警 (℃)</text>
            <text style="font-size: 32rpx; font-weight: 500; color: #5AC8FA;">{{configForm.dewPointMax}}</text>
          </view>
          <view style="display: flex; align-items: center;">
            <t-slider value="{{configForm.dewPointMax}}" min="-40" max="80" step="1" label="{{false}}" bind:change="onConfigSliderChange" data-field="dewPointMax" style="flex: 1; --td-slider-bar-height: 6rpx; --td-slider-thumb-size: 40rpx; --td-slider-active-color: #5AC8FA; --td-slider-track-color: #EEEFF0;"/>
          </view>
        </view>

      </view>
    </view>
    
  </view>
</view>

<!-- 底部操作与确认区域 -->
<view style="position: fixed; bottom: 0; left: 0; right: 0; padding: 24rpx 40rpx calc(env(safe-area-inset-bottom) + 24rpx); background: rgba(242,242,247,0.85); backdrop-filter: blur(20px); z-index: 100;">
  <view bindtap="saveDeviceConfigAction" hover-class="button-hover" hover-start-time="20" hover-stay-time="70" style="display: flex; justify-content: center; align-items: center; gap: 16rpx; padding: 28rpx 0; border-radius: 40rpx; font-size: 34rpx; font-weight: 600; color: #FFF; background: #007AFF; box-shadow: 0 12rpx 32rpx rgba(0,122,255,0.25); transition: all 0.2s;">
    <t-icon name="cloud-upload" size="44rpx" color="#FFF" />
    <text>立即应用阈值</text>
  </view>
</view>

<t-toast id="t-toast" />
