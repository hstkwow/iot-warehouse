.container {
  min-height: 100vh;
  background-color: #F4F5F9;
  position: relative;
  padding-bottom: 40rpx;
}

.top-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 380rpx;
  background: linear-gradient(180deg, #5D87FF 0%, #7C5CFC 50%, rgba(124,92,252,0) 100%);
  z-index: 0;
}

/* ===== 分区卡片 ===== */
.section-card {
  position: relative;
  z-index: 1;
  background: #ffffff;
  border-radius: 24rpx;
  margin: 0 28rpx 24rpx;
  padding: 0 32rpx 24rpx;
  box-shadow: 0 6rpx 24rpx rgba(0, 0, 0, 0.04);
}

.section-card:first-of-type {
  margin-top: 32rpx;
}

.section-header {
  display: flex;
  align-items: center;
  padding: 28rpx 0 20rpx;
  border-bottom: 1rpx solid #f0f0f5;
  margin-bottom: 16rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-left: 12rpx;
}

.section-hint {
  font-size: 22rpx;
  color: #bbb;
  margin-left: auto;
}

/* ===== 上传区 ===== */
.upload-area {
  padding: 16rpx 0 8rpx;
}

/* ===== 表单行 ===== */
.form-row {
  padding: 12rpx 0;
}

.form-label {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 8rpx;
  display: flex;
  align-items: center;
}

.required {
  color: #FA896B;
  margin-right: 6rpx;
  font-weight: bold;
}

.form-divider {
  height: 1rpx;
  background: #f5f5fa;
  margin: 4rpx 0;
}

.form-row-group {
  display: flex;
  gap: 24rpx;
  padding: 12rpx 0;
}

.form-row-half {
  flex: 1;
  background: #f8f9fd;
  border-radius: 16rpx;
  padding: 16rpx 20rpx;
}

.form-row-half .form-label {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 4rpx;
}

/* ===== 选择器单元格 ===== */
.picker-cell {
  padding: 0 !important;
}

.no-value {
  color: rgba(0,0,0,0.26) !important;
  font-size: 32rpx;
}

.has-value {
  color: rgba(0,0,0,0.9) !important;
  font-size: 32rpx;
}

/* ===== 提交按钮 ===== */
.btn-wrap {
  position: relative;
  z-index: 1;
  margin: 40rpx 48rpx 0;
}

.submit-btn {
  background: linear-gradient(135deg, #5D87FF, #7C5CFC) !important;
  border: none !important;
  color: #ffffff !important;
  border-radius: 48rpx !important;
  font-weight: 600 !important;
  font-size: 30rpx !important;
  box-shadow: 0 10rpx 30rpx rgba(93, 135, 255, 0.3) !important;
  letter-spacing: 4rpx;
}
