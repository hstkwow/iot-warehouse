<view class="container">
  <!-- 动态模糊背景 -->
  <view class="bg-blur-circle bg-azure"></view>
  <view class="bg-blur-circle bg-teal"></view>

  <!-- 顶部透明沉浸式背景 -->
  <view class="header-bg">
    <view class="page-title">库存管理</view>
    
    <!-- 自定义胶囊 Tab -->
    <view class="capsule-tabs">
      <view class="capsule-tab {{currentTab === 0 ? 'capsule-active' : ''}}" data-idx="0" bind:tap="onTabTap">
        <t-icon name="app" size="36rpx" />
        <text>物资</text>
      </view>
      <view class="capsule-tab {{currentTab === 1 ? 'capsule-active' : ''}}" data-idx="1" bind:tap="onTabTap">
        <t-icon name="chart-pie" size="36rpx" />
        <text>库存</text>
      </view>
      <view class="capsule-tab {{currentTab === 2 ? 'capsule-active' : ''}}" data-idx="2" bind:tap="onTabTap">
        <t-icon name="map-information" size="36rpx" />
        <text>库位</text>
      </view>
    </view>

    <!-- 搜索栏与操作按钮 (仅在物资列表可见) -->
    <view class="search-box-wrap" wx:if="{{currentTab === 0}}">
      <view class="action-top-bar">
        <view class="apple-search-bar">
          <t-icon name="search" size="32rpx" color="#8E8E93" class="search-icon"/>
          <input class="apple-search-input" value="{{searchKeyword}}" placeholder="搜索物资..." placeholder-class="apple-search-placeholder" bindinput="onSearchInput" confirm-type="search" />
          <t-icon wx:if="{{searchKeyword}}" name="close-circle-filled" size="32rpx" color="#8E8E93" class="clear-icon" bind:tap="clearSearch"/>
        </view>
        <view class="apple-add-btn" bind:tap="navToAddMaterial">
          <t-icon name="add" size="32rpx" color="#007AFF"/>
          <text>新增</text>
        </view>
      </view>
    </view>
  </view>

  <!--   内容展示区   -->

  <!-- Tab 0: 物资列表 -->
  <view wx:if="{{currentTab === 0}}" class="tab-content list-wrapper">
    <!-- 总结数据卡片 -->
    <view class="card stock-summary-light" style="margin: 0 0 40rpx 0;">
      <view class="summary-item">
        <text class="s-label">物资总数</text>
        <text class="s-value">{{totalStockCount !== undefined ? totalStockCount : stockList.length || 0}}</text>
      </view>
      <view class="summary-divider"></view>
      <view class="summary-item">
        <text class="s-label">库存不足</text>
        <text class="s-value" style="color: #FF3B30;">{{lowStockCount || 0}}</text>
      </view>
    </view>

    <!-- 如果没有数据 -->
    <view wx:if="{{stockList.length === 0}}" class="empty-state">
      <t-empty icon="info-circle" description="暂无相关物资" />
    </view>

    <!-- 物资项目列表 -->
    <block wx:for="{{filteredList}}" wx:key="id">
      <view class="card material-item" bind:tap="navToDetail" data-id="{{item.materialId || item.id}}">
        <view class="m-icon">
          <image class="real-image" src="{{item.image || 'data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHdpZHRoPSIxMDAiIGhlaWdodD0iMTAwIiB2aWV3Qm94PSIwIDAgMjQgMjQiIGZpbGw9IiNjOGM5Y2MiPjxwYXRoIGQ9Ik0yMSAxNi41bC05IDUuMjUtOS01LjI1VjcuNUwxMiAyLjI1bDkgNS4yNXY5ek0xMiA0LjVsLTYuNSAzLjc1TDEyIDEzLjVsNi41LTMuNzVMMTIgNC41eiIvPjwvc3ZnPg=='}}" mode="aspectFill" style="width:100%; height:100%; border-radius:24rpx;"/>
        </view>
        <view class="m-content">
          <view class="m-header">
            <view>
              <view class="m-name">{{item.name}}</view>
              <view class="m-category">{{item.categoryName || '未分类'}}</view>
            </view>
            <view class="m-amount {{item.amount < (item.minStock || 10) ? 'm-low' : ''}}">
              {{item.amount || 0}}
              <text>{{item.unit || '件'}}</text>
            </view>
          </view>
          <view class="m-desc">编号: {{item.serialNo || item.id}} {{item.specs ? '| ' + item.specs : ''}}</view>
        </view>
      </view>
    </block>

    <!-- 加载更多说明 -->
    <view wx:if="{{!hasMore && stockList.length > 0}}" style="text-align: center; color: #86868B; font-size: 24rpx; padding: 40rpx 0 60rpx;">
      没有更多物资了
    </view>
  </view>

  <!-- Tab 1: 按分类统计 -->
  <view wx:elif="{{currentTab === 1}}" class="tab-content list-wrapper">
    <!-- 1. 库存预警 -->
    <view class="section-title" style="margin-top: 10rpx; margin-bottom: 24rpx; margin-left: 12rpx; font-size: 32rpx; font-weight: 600; color: #FF3B30;">库存预警</view>
    <view class="card" style="padding: 16rpx 32rpx; margin-left: 0; margin-right: 0; border: 1px solid rgba(255,59,48,0.15);">
      <view wx:if="{{warningList.length > 0}}">
        <view wx:for="{{warningListDisplay}}" wx:key="alarmId" style="border-bottom: 1rpx solid rgba(0,0,0,0.05); padding: 24rpx 0;" bind:tap="viewAlarmDetail" data-alarm="{{item.originalData}}">
          <view style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12rpx;">
            <view style="display: flex; align-items: center; gap: 12rpx;">
              <t-icon name="error-circle-filled" size="40rpx" color="{{item.alertType === 'low' ? '#FF3B30' : '#FF9500'}}"/>
              <text style="font-size: 32rpx; font-weight: 600; color: #333333;">{{item.materialName}}</text>
            </view>
            <text style="font-size: 24rpx; color: #8E8E93;">{{item.createTime}}</text>
          </view>
          <view style="display: flex; justify-content: space-between; align-items: center; padding-left: 52rpx; margin-top: 8rpx;">
            <view style="display: flex; align-items: center; background: {{item.alertType === 'low' ? 'rgba(255,59,48,0.1)' : 'rgba(255,149,0,0.1)'}}; padding: 4rpx 16rpx; border-radius: 8rpx;">
              <text style="font-size: 24rpx; color: {{item.alertType === 'low' ? '#FF3B30' : '#FF9500'}}; margin-right: 8rpx;">当前库存:</text>
              <text style="font-size: 26rpx; font-weight: 600; color: {{item.alertType === 'low' ? '#FF3B30' : '#FF9500'}};">{{item.currentStock}}</text>
            </view>
            <view style="display: flex; align-items: center; background: rgba(0,0,0,0.04); padding: 4rpx 16rpx; border-radius: 8rpx;">
              <text style="font-size: 24rpx; color: #8E8E93; margin-right: 8rpx;">{{item.alertType === 'low' ? '低于最低限:' : '高于最高限:'}}</text>
              <text style="font-size: 26rpx; font-weight: 600; color: #333333;">{{item.threshold}}</text>
            </view>
          </view>
        </view>
        <view wx:if="{{hasMoreWarningList || warningListExpanded}}" class="fold-action" bind:tap="toggleWarningListFold">
          <text>{{warningListExpanded ? '收起' : '展开全部'}}（{{warningList.length}}）</text>
        </view>
      </view>
      <view wx:else style="display: flex; justify-content: center; align-items: center; color: #34C759; padding: 24rpx 0; font-size: 28rpx;">
        <t-icon name="check-circle-filled" size="40rpx" color="#34C759" style="margin-right: 12rpx;"/>库存全量健康
      </view>
    </view>

    <!-- 2. 出入库记录 -->
    <view class="section-title" style="margin-top: 40rpx; margin-bottom: 24rpx; margin-left: 12rpx; font-size: 32rpx; font-weight: 600; color: #333333;">最新出入库记录</view>
    <view class="card" style="padding: 0 32rpx; margin-left: 0; margin-right: 0;">
      <view wx:if="{{statsIoRecords.length > 0}}">
        <view wx:for="{{statsIoRecordsDisplay}}" wx:key="recordId" bind:tap="viewIoRecordDetail" data-record="{{item}}" style="display: flex; align-items: center; justify-content: space-between; padding: 32rpx 0; border-bottom: 1rpx solid rgba(0,0,0,0.05);">
          <view style="display: flex; align-items: center; gap: 24rpx; flex: 1; overflow: hidden;">
            <view style="width: 80rpx; height: 80rpx; border-radius: 40rpx; background: {{item.ioType === 1 ? 'rgba(52,199,89,0.1)' : 'rgba(255,149,0,0.1)'}}; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
              <t-icon name="{{item.ioType === 1 ? 'login' : 'logout'}}" size="44rpx" color="{{item.ioType === 1 ? '#34C759' : '#FF9500'}}" />
            </view>
            <view style="flex: 1; overflow: hidden;">
                <view style="font-size: 36rpx; font-weight: 500; color: #333333; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">{{item.materialName || '未知物资'}}</view>
                <view style="font-size: 28rpx; color: #8E8E93; margin-top: 8rpx;">库位: {{item.locationName || '--'}}</view>
              </view>
            </view>
            <view style="display: flex; flex-direction: column; align-items: flex-end; flex-shrink: 0;">
              <view style="font-size: 38rpx; font-weight: 600; color: {{item.ioType === 1 ? '#34C759' : '#FF9500'}};">{{item.ioType === 1 ? '+' : '-'}}{{item.quantity}}</view>
              <view style="font-size: 26rpx; color: #8E8E93; margin-top: 8rpx;">{{item.date || '--'}}</view>
          </view>
        </view>
        <view wx:if="{{hasMoreStatsIoRecords || statsIoRecordsExpanded}}" class="fold-action" bind:tap="toggleIoRecordsFold">
          <text>{{statsIoRecordsExpanded ? '收起' : '展开全部'}}（{{statsIoRecords.length}}）</text>
        </view>
      </view>
      <view wx:else class="io-empty-state">
        <view class="io-empty-state__badge">
          <t-icon name="time" size="40rpx" color="#5D87FF" />
        </view>
        <view class="io-empty-state__title">暂时没有出入库记录</view>
        <view class="io-empty-state__desc">后续入库、出库或移库操作会优先显示在这里，方便你快速查看最近动态。</view>
      </view>
    </view>

    <!-- 3. 分类占比统计 -->
    <view class="section-title" style="margin-top: 40rpx; margin-left: 12rpx; font-size: 32rpx; font-weight: 600; color: #333333;">分类统计</view>
    <view wx:if="{{categoryStats.length === 0}}" class="empty-state">
      <t-empty icon="chart-bar" description="暂无分类统计数据" />
    </view>
    <block wx:for="{{categoryStatsDisplay}}" wx:key="categoryId">
      <view class="card c-item" style="margin-bottom: 24rpx; padding: 32rpx;">
        <view class="c-header" style="display: flex; justify-content: space-between; margin-bottom: 16rpx;">
          <view class="c-name" style="font-size: 32rpx; font-weight: 600;">{{item.name}}</view>
          <view class="c-stat" style="font-size: 26rpx; color: #8E8E93;">{{item.count}} 种 | 共 {{item.totalAmount}} 件</view>
        </view>
        <view class="progress-wrap">
          <t-progress theme="plump" color="#007AFF" percentage="{{item.percent}}" />
        </view>
      </view>
    </block>
    <view wx:if="{{hasMoreCategoryStats || categoryStatsExpanded}}" class="fold-action" bind:tap="toggleCategoryStatsFold">
      <text>{{categoryStatsExpanded ? '收起' : '展开全部'}}（{{categoryStats.length}}）</text>
    </view>
  </view>

<!-- Tab 2: 库位视图 -->
    <view wx:else class="tab-content">
      <!-- 库位统计 -->
      <view class="card" style="padding: 32rpx; margin-left: 0; margin-right: 0;">
        <view style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 32rpx;">
          <view style="font-size: 32rpx; font-weight: 600; color: #333333;">库位统计</view>
          <view class="apple-add-btn" style="height: 56rpx; padding: 0 20rpx; border-radius: 16rpx; box-shadow: none; margin: 0;" bind:tap="showAddZoneForm">
            <t-icon name="add" size="28rpx" color="#007AFF" />
            <text style="font-size: 26rpx; font-weight: 600; color: #007AFF;">添加区域</text>
          </view>
        </view>
        <view style="display: flex; justify-content: space-between; text-align: center; background: rgba(0,0,0,0.02); border-radius: 20rpx; padding: 24rpx;">
          <view style="flex: 1;">
            <view style="font-size: 40rpx; font-weight: 700; color: #1C1C1E; margin-bottom: 8rpx;">{{locationStats.total}}</view>
            <view style="font-size: 24rpx; color: #8E8E93;">总库位</view>
          </view>
          <view style="width: 1rpx; background: rgba(0,0,0,0.05); margin: 0 16rpx;"></view>
          <view style="flex: 1;">
            <view style="font-size: 40rpx; font-weight: 700; color: #34C759; margin-bottom: 8rpx;">{{locationStats.occupied}}</view>
            <view style="font-size: 24rpx; color: #8E8E93;">已占用</view>
          </view>
          <view style="width: 1rpx; background: rgba(0,0,0,0.05); margin: 0 16rpx;"></view>
          <view style="flex: 1;">
            <view style="font-size: 40rpx; font-weight: 700; color: #007AFF; margin-bottom: 8rpx;">{{locationStats.free}}</view>
            <view style="font-size: 24rpx; color: #8E8E93;">空闲</view>
          </view>
          <view style="width: 1rpx; background: rgba(0,0,0,0.05); margin: 0 16rpx;"></view>
          <view style="flex: 1;">
            <view style="font-size: 40rpx; font-weight: 700; color: #FF9500; margin-bottom: 8rpx;">{{locationStats.rate}}</view>
            <view style="font-size: 24rpx; color: #8E8E93;">占用率</view>
          </view>
        </view>
      </view>

      <!-- 区域与库位列表 -->
      <view wx:if="{{locationZones.length > 0}}">
        <view class="card" wx:for="{{locationZones}}" wx:key="id" style="padding: 32rpx; margin-left: 0; margin-right: 0; margin-bottom: 32rpx; border: 2rpx solid rgba(0,0,0,0.03); box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.02);">
          <view style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 32rpx; padding-bottom: 24rpx; border-bottom: 1rpx solid rgba(0,0,0,0.05);">
            <view style="font-size: 34rpx; font-weight: 600; color: #1C1C1E; display: flex; align-items: center;">
              <view style="width: 8rpx; height: 32rpx; background: #007AFF; border-radius: 4rpx; margin-right: 16rpx;"></view>
              {{item.name}}
            </view>
            <view style="display: flex; gap: 12rpx;">
              <view bind:tap="showAddBinForm" data-zone="{{item}}" class="apple-add-btn" style="height: 52rpx; padding: 0 16rpx; border-radius: 12rpx; box-shadow: none;">
                <t-icon name="add" size="28rpx" color="#007AFF" />
                <text style="font-size: 24rpx; font-weight: 500; color: #007AFF;">添加库位</text>
              </view>
              <view bind:tap="showEditZoneForm" data-zone="{{item}}" style="display: flex; align-items: center; justify-content: center; padding: 12rpx 20rpx; font-size: 24rpx; font-weight: 500; color: #1C1C1E; background: #F2F2F7; border-radius: 12rpx;">
                <t-icon name="edit" size="28rpx" style="margin-right: 4rpx;" /> 编辑
              </view>
              <view bind:tap="onDeleteZone" data-zone="{{item}}" style="display: flex; align-items: center; justify-content: center; padding: 12rpx 20rpx; font-size: 24rpx; font-weight: 500; color: #FF3B30; background: rgba(255,59,48,0.08); border-radius: 12rpx;">
                <t-icon name="delete" size="28rpx" style="margin-right: 4rpx;" /> 删除
              </view>
            </view>
          </view>
          
          <scroll-view class="bin-scroll" scroll-x enable-flex show-scrollbar="false">
            <view class="bin-row">
              <view wx:for="{{item.bins}}" wx:for-item="loc" wx:key="id" bind:tap="onLocationTap" data-bin="{{loc}}" class="bin-card" style="border: 2rpx solid {{loc.isOccupied ? 'rgba(52,199,89,0.15)' : 'rgba(0,0,0,0.06)'}}; background: {{loc.isOccupied ? '#F4FBF5' : '#FFFFFF'}};">
                <view class="bin-dot" style="background: {{loc.isOccupied ? '#34C759' : '#C7C7CC'}};"></view>
                <view class="bin-name">{{loc.name}}</view>
                <view class="bin-status" style="color: {{loc.isOccupied ? '#34C759' : '#8E8E93'}}; background: {{loc.isOccupied ? 'rgba(52,199,89,0.1)' : 'rgba(0,0,0,0.04)'}};">
                  {{loc.isOccupied ? '已占用' : '空闲'}}
                </view>
              </view>
            </view>
          </scroll-view>
          <view wx:if="{{item.bins.length === 0}}" style="text-align: center; padding: 40rpx 0; background: #F9F9F9; border-radius: 20rpx; border: 2rpx dashed rgba(0,0,0,0.05); margin-top: 16rpx;">
            <t-icon name="view-module" size="64rpx" color="#D1D1D6" style="margin-bottom: 12rpx;" />
            <view style="color: #8E8E93; font-size: 26rpx;">该区域暂无库位</view>
          </view>
        </view>
      </view>
      <view wx:else style="padding: 60rpx 0;">
        <t-empty icon="view-module" description="暂无库位数据" />
    </view>
  </view>

    <!-- 库位详情弹窗 -->
    <t-popup visible="{{showLocationDetail}}" bind:visible-change="onLocationDetailVisibleChange" placement="bottom">
      <view style="background: #FFF; padding: 48rpx; border-radius: 48rpx 48rpx 0 0; min-height: 40vh; z-index: 9999;">
        <view style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 48rpx;">
          <view style="display: flex; align-items: center; gap: 16rpx;">
            <view style="width: 10rpx; height: 36rpx; background: #007AFF; border-radius: 6rpx;"></view>
            <view style="font-size: 40rpx; font-weight: 600; color: #1C1C1E; letter-spacing: 1rpx;">{{selectedLocation.name || '库位详情'}}</view>
          </view>
          <view bind:tap="closeLocationDetail" style="width: 60rpx; height: 60rpx; background: rgba(0,0,0,0.04); border-radius: 30rpx; display: flex; align-items: center; justify-content: center;">
            <t-icon name="close" size="40rpx" color="#8E8E93" />
          </view>
        </view>
        
        <view style="margin-bottom: 64rpx; background: #F9F9F9; border-radius: 24rpx; padding: 32rpx;">
          <view style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 32rpx;">
            <view style="font-size: 28rpx; color: #8E8E93;">库位编号</view>
            <view style="font-size: 30rpx; font-weight: 500; color: #333333; font-family: monospace; background: rgba(0,0,0,0.04); padding: 4rpx 16rpx; border-radius: 8rpx;">{{selectedLocation.id}}</view>
          </view>
          <view style="height: 1px; background: rgba(0,0,0,0.04); margin-bottom: 32rpx;"></view>
          <view style="display: flex; justify-content: space-between; align-items: center; margin-bottom: {{selectedLocation.isOccupied ? '32rpx' : '0'}};">
            <view style="font-size: 28rpx; color: #8E8E93;">占用状态</view>
            <view style="display: flex; align-items: center; gap: 12rpx;">
              <view style="width: 12rpx; height: 12rpx; border-radius: 50%; background: {{selectedLocation.isOccupied ? '#34C759' : '#C7C7CC'}};"></view>
              <view style="font-size: 30rpx; font-weight: 600; color: {{selectedLocation.isOccupied ? '#34C759' : '#8E8E93'}};">
                {{selectedLocation.isOccupied ? '已占用' : '空闲'}}
              </view>
            </view>
          </view>
          <view wx:if="{{selectedLocation.isOccupied}}" style="height: 1px; background: rgba(0,0,0,0.04); margin-bottom: 32rpx;"></view>
          <view wx:if="{{selectedLocation.isOccupied}}" style="display: flex; justify-content: space-between; align-items: center;">
            <view style="font-size: 28rpx; color: #8E8E93;">存放物资</view>
            <view style="font-size: 30rpx; font-weight: 500; color: #333333;">
              {{selectedLocation.materialName}} <text style="color: #8E8E93; font-size: 26rpx; margin-left: 8rpx;">(共{{selectedLocation.stockCount}}件)</text>
            </view>
          </view>
        </view>

        <view style="display: flex; justify-content: space-between; gap: 24rpx; padding-bottom: env(safe-area-inset-bottom);">
          <view bind:tap="onDeleteBin" style="flex: 1; height: 96rpx; display: flex; align-items: center; justify-content: center; gap: 12rpx; background: #FFF; border: 2rpx solid rgba(255,59,48,0.3); color: #FF3B30; border-radius: 24rpx; font-size: 32rpx; font-weight: 600;">
            <t-icon name="delete" size="36rpx" />
            <text>删除</text>
          </view>
          <view bind:tap="showEditBinForm" style="flex: 2; height: 96rpx; display: flex; align-items: center; justify-content: center; gap: 12rpx; background: #007AFF; color: #FFFFFF; border-radius: 24rpx; font-size: 32rpx; font-weight: 600; box-shadow: 0 12rpx 24rpx rgba(0,122,255,0.25);">
            <t-icon name="edit" size="36rpx" />
            <text>编辑信息</text>
          </view>
        </view>
      </view>
    </t-popup>
    
    <!-- 增加区域/库位弹窗表单 -->
    <t-dialog visible="{{showLocForm}}" title="{{locFormIsEdit ? (locFormType === 1 ? '编辑区域' : '编辑库位') : (locFormType === 1 ? '添加区域' : '添加库位')}}" confirm-btn="保存" cancel-btn="取消" bind:confirm="confirmLocForm" bind:cancel="closeLocForm">
      <view slot="content" style="padding-top: 32rpx; padding-bottom: 8rpx;">
        <view style="font-size: 28rpx; color: #333333; font-weight: 500; margin-bottom: 20rpx; text-align: left;">
          {{locFormType === 1 ? '区域' : '库位'}}名称 <text style="color: #FF3B30;">*</text>
        </view>
        <view style="background: #F2F2F7; border-radius: 20rpx; padding: 24rpx 28rpx; display: flex; align-items: center; border: 2rpx solid rgba(0,0,0,0.02);">
          <t-icon name="{{locFormType === 1 ? 'map-information' : 'view-module'}}" size="36rpx" color="#8E8E93" style="margin-right: 16rpx;" />
          <input placeholder="{{locFormType === 1 ? '例如：A区、第一仓库' : '例如：A-101、货架01'}}" placeholder-style="color: #C7C7CC;" value="{{locFormName}}" bindinput="onLocFormNameInput" style="font-size: 32rpx; flex: 1; color: #1C1C1E; text-align: left;" />
        </view>
        <view wx:if="{{locFormType === 2}}" style="margin-top: 32rpx; text-align: left; background: rgba(0,122,255,0.05); padding: 18rpx 24rpx; border-radius: 16rpx; display: flex; align-items: center;">
          <t-icon name="root-list" size="32rpx" color="#007AFF" style="margin-right: 12rpx;"/>
