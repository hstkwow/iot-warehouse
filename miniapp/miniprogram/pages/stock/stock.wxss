page {
  background-color: transparent !important;
}

.container {
  min-height: 100vh;
  position: relative;
  overflow: hidden;
  background-color: transparent;
  padding-bottom: calc(env(safe-area-inset-bottom) + 240rpx);
  z-index: 1;
}

/* 动态背景模糊圆点复用 (修改为上下环绕深邃版) */
.bg-blur-circle {
  position: fixed;
  border-radius: 50%;
  filter: blur(100px);
  z-index: 0;
  pointer-events: none;
}
.bg-azure {
  width: 600rpx;
  height: 600rpx;
  background: rgba(0, 122, 255, 0.12);
  top: -100rpx;
  left: -200rpx;
  animation: floatAzure 14s cubic-bezier(0.4, 0, 0.2, 1) infinite alternate;
}
.bg-teal {
  width: 500rpx;
  height: 500rpx;
  background: rgba(90, 200, 250, 0.15);
  bottom: 100rpx;
  right: -150rpx;
  animation: floatTeal 16s cubic-bezier(0.4, 0, 0.2, 1) infinite alternate;
  animation-delay: -5s;
}

/* 顶部沉浸式标题栏背景 */
.header-bg {
  width: 100%;
  padding-top: calc(env(safe-area-inset-top) + 140rpx);
  padding-bottom: 20rpx;
  background: transparent;
  display: flex;
  flex-direction: column;
  position: relative;
  z-index: 2;
  animation: slideUpFade 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
}

.page-title {
  font-size: 52rpx;
  font-weight: 700;
  color: #1D1D1F;
  padding: 0 40rpx;
  letter-spacing: -1rpx;
}

/* 自定义胶囊 Tab */
.capsule-tabs {
  margin: 32rpx 40rpx 20rpx;
  display: flex;
  background: rgba(255, 255, 255, 0.5);
  border-radius: 32rpx;
  padding: 10rpx;
  position: relative;
  z-index: 2;
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 1px solid rgba(255, 255, 255, 0.4);
  box-shadow: 0 8px 16px rgba(0,0,0,0.03);
}

.capsule-tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  border-radius: 24rpx;
  font-size: 28rpx;
  color: #86868B;
  font-weight: 500;
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 8rpx;
  transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
}

.capsule-active {
  background: #FFFFFF;
  color: #1D1D1F;
  font-weight: 600;
  box-shadow: 0 8rpx 16rpx rgba(0, 0, 0, 0.05);
}

/* 操作及搜索栏 */
.search-box-wrap {
  margin: 20rpx 40rpx;
  position: relative;
  z-index: 2;
}

.action-top-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20rpx;
}

.apple-search-bar {
  flex: 1;
  height: 72rpx;
  background: rgba(255, 255, 255, 0.6);
  border: 1rpx solid rgba(255, 255, 255, 0.9);
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  padding: 0 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.03);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
}

.search-icon {
  margin-right: 12rpx;
}

.apple-search-input {
  flex: 1;
  font-size: 30rpx;
  color: #1C1C1E;
  height: 100%;
}

.apple-search-placeholder {
  color: #8E8E93;
}

.clear-icon {
  padding: 8rpx;
}

.apple-add-btn {
  height: 72rpx;
  padding: 0 28rpx;
  background: rgba(0, 122, 255, 0.1);
  border-radius: 20rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 6rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 122, 255, 0.08);
  backdrop-filter: blur(10px);
}

.apple-add-btn text {
  font-size: 28rpx;
  font-weight: 600;
  color: #007AFF;
}

/* 内容展示区统一设定 */
.tab-content {
  position: relative;
  z-index: 2;
  padding: 0 40rpx;
  animation: fadeIn 0.4s ease forwards;
}

/* 统一统计数据卡片 */
.stock-summary-light {
  padding: 24rpx 40rpx;
  border-radius: 32rpx;
  margin-bottom: 24rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.summary-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.s-label {
  font-size: 24rpx;
  color: #86868B;
  margin-bottom: 12rpx;
  font-weight: 500;
}

.s-value {
  font-size: 40rpx;
  font-weight: 700;
  color: #1D1D1F;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
}

.summary-divider {
  width: 1px;
  height: 60rpx;
  background: rgba(0, 0, 0, 0.08);
}

/* 列表卡片 (物资项) */
.list-wrapper {
  margin-bottom: 40rpx;
}
.material-item {
  margin-bottom: 24rpx !important;
  margin-left: 0 !important;
  margin-right: 0 !important;
  padding: 32rpx !important;
  border-radius: 32rpx !important;
  display: flex;
  position: relative;
}

.m-icon {
  width: 100rpx;
  height: 100rpx;
  background: #F4F5F9;
  border-radius: 24rpx;
  overflow: hidden;
  margin-right: 24rpx;
  flex-shrink: 0;
}
.m-icon t-image {
  width: 100%;
  height: 100%;
}

.m-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.m-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 8rpx;
}
.m-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #1D1D1F;
}
.m-category {
  font-size: 24rpx;
  color: #5D87FF;
  background: rgba(93, 135, 255, 0.1);
  padding: 4rpx 16rpx;
  border-radius: 12rpx;
  margin-top: 8rpx;
  display: inline-block;
  font-weight: 600;
}

.m-amount {
  font-size: 36rpx;
  color: #34C759;
  font-weight: 700;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
}

.m-low {
  color: #FF3B30;
}

.m-amount text {
  font-size: 24rpx;
  font-weight: normal;
  color: #8E8E93;
  margin-left: 4rpx;
}

.m-desc {
  font-size: 26rpx;
  color: #86868B;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.m-footer {
  margin-top: 16rpx;
  display: flex;
  justify-content: flex-end;
}

.m-footer t-button {
  border-radius: 16rpx !important;
}

/* 分类卡片样式 */
.c-item {
  margin-bottom: 24rpx !important;
  margin-left: 0 !important;
  margin-right: 0 !important;
  padding: 32rpx !important;
  border-radius: 32rpx !important;
}
.c-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}
.c-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #1D1D1F;
}
.c-stat {
  font-size: 28rpx;
  color: #86868B;
  font-weight: 500;
}

.progress-wrap {
  margin-top: 16rpx;
}

.io-empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 56rpx 24rpx;
  margin: 28rpx 0;
  border-radius: 28rpx;
  background: linear-gradient(180deg, rgba(247, 250, 255, 0.96) 0%, rgba(240, 246, 255, 0.88) 100%);
  border: 1rpx solid rgba(93, 135, 255, 0.12);
}

.io-empty-state__badge {
  width: 96rpx;
  height: 96rpx;
  border-radius: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(93, 135, 255, 0.14);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.92);
  margin-bottom: 24rpx;
}

.io-empty-state__title {
  font-size: 32rpx;
  line-height: 1.3;
  font-weight: 700;
  color: #22314d;
  margin-bottom: 12rpx;
}

.io-empty-state__desc {
  max-width: 520rpx;
  font-size: 25rpx;
  line-height: 1.7;
  color: #7a8599;
  text-align: center;
}

.fold-action {
  padding: 20rpx 0 12rpx;
  text-align: center;
  color: #007AFF;
  font-size: 26rpx;
  font-weight: 600;
}

.bin-scroll {
  width: 100%;
}

.bin-row {
  display: flex;
  flex-wrap: nowrap;
  gap: 24rpx;
  padding-bottom: 8rpx;
}

.bin-card {
  position: relative;
  width: 200rpx;
  flex-shrink: 0;
  padding: 28rpx 16rpx;
  border-radius: 20rpx;
  text-align: center;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.02);
}

.bin-dot {
  position: absolute;
  right: 12rpx;
  top: 12rpx;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
}

.bin-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1c1c1e;
  margin-bottom: 8rpx;
  font-family: monospace;
}

.bin-status {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
  display: inline-block;
}

/* Animations */
@keyframes floatAzure {
  0% { transform: translate(0, 0) scale(1) rotate(0deg); }
  33% { transform: translate(150rpx, 200rpx) scale(1.15) rotate(10deg); }
  66% { transform: translate(80rpx, 350rpx) scale(0.9) rotate(-5deg); }
  100% { transform: translate(250rpx, 100rpx) scale(1.05) rotate(15deg); }
}
@keyframes floatTeal {
  0% { transform: translate(0, 0) scale(1) rotate(0deg); }
  33% { transform: translate(-200rpx, -150rpx) scale(1.2) rotate(-15deg); }
  66% { transform: translate(-300rpx, 50rpx) scale(0.85) rotate(10deg); }
  100% { transform: translate(-100rpx, -250rpx) scale(1.1) rotate(-5deg); }
}
@keyframes slideUpFade {
  0% { transform: translateY(40rpx); opacity: 0; }
  100% { transform: translateY(0); opacity: 1; }
}
@keyframes fadeIn {
  0% { opacity: 0; }
  100% { opacity: 1; }
}
