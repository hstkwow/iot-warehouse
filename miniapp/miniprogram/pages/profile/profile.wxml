<view class="profile-container">
  <!-- 动态模糊背景 -->
  <view class="bg-blur-circle bg-azure"></view>
  <view class="bg-blur-circle bg-teal"></view>

  <!-- 顶部通明沉浸式背景 -->
  <view class="header-bg apple-header" style="padding-top: {{statusBarHeight + 12}}px; padding-bottom: 24rpx; display: flex; flex-direction: column;">
    <view class="title-group" style="padding: 0 40rpx; margin-bottom: 32rpx;">
      <view class="page-title">个人中心</view>
    </view>
  </view>

  <view class="content-body">
    <!-- 头像区域（现代卡片式） -->
    <view class="section-card user-card" style="margin-top: 10rpx;">
      <image class="avatar" src="{{userInfo.avatar || defaultAvatar}}" mode="aspectFill"></image>
      <view class="info-content">
        <view class="username" bindtap="handleEditUsername">
          <text class="name-text">{{userInfo.nickname || userInfo.username || '未登录用户'}}</text>
          <view class="edit-icon-wrap">
            <t-icon name="edit-1" size="28rpx" color="#007AFF" />
          </view>
        </view>
        <view class="user-id">角色绑定: {{userInfo.role || '系统操作员'}}</view>
      </view>
    </view>

    <!-- 数据面板 -->
    <view class="section-card stats-card">
      <view class="stat-item">
        <text class="stat-num">{{stats.devices}}</text>
        <text class="stat-label">我的设备</text>
      </view>
      <view class="stat-divider"></view>
      <view class="stat-item">
        <text class="stat-num">{{stats.lowStock}}</text>
        <text class="stat-label">库存预警</text>
      </view>
      <view class="stat-divider"></view>
      <view class="stat-item">
        <text class="stat-num" style="{{stats.alarms > 0 ? 'color: #FF3B30;' : ''}}">{{stats.alarms}}</text>
        <text class="stat-label">未解决预警</text>
      </view>
    </view>

    <!-- 功能菜单区 -->
    <view class="section-card menu-card">
      <view class="menu-item" bindtap="handleMenuClick" data-type="alerts" hover-class="menu-hover">
        <view class="menu-left">
          <view class="icon-box" style="background: rgba(0, 122, 255, 0.1);">
            <t-icon name="notification" size="40rpx" color="#007AFF" />
          </view>
          <text class="menu-text">预警消息</text>
        </view>
        <t-icon name="chevron-right" size="32rpx" color="#C0C4CC" />
      </view>
      <view class="menu-divider"></view>
      
      <view class="menu-item" bindtap="handleMenuClick" data-type="security" hover-class="menu-hover">
        <view class="menu-left">
          <view class="icon-box" style="background: rgba(52, 199, 89, 0.1);">
            <t-icon name="lock-on" size="40rpx" color="#34C759" />
          </view>
          <text class="menu-text">账号安全</text>
        </view>
        <t-icon name="chevron-right" size="32rpx" color="#C0C4CC" />
      </view>
      <view class="menu-divider"></view>

      <view class="menu-item" bindtap="handleMenuClick" data-type="about" hover-class="menu-hover">
        <view class="menu-left">
          <view class="icon-box" style="background: rgba(175, 82, 222, 0.1);">
            <t-icon name="info-circle" size="40rpx" color="#AF52DE" />
          </view>
          <text class="menu-text">关于我们</text>
        </view>
        <t-icon name="chevron-right" size="32rpx" color="#C0C4CC" />
      </view>
    </view>

    <!-- 底部退出按钮 -->
    <view class="logout-box">
      <view class="btn-logout" bindtap="handleLogout" hover-class="logout-hover">退出当前账号</view>
    </view>
    
    <view class="footer-copy">V 1.0.0 智能仓储管理</view>
  </view>
</view>

<!-- 修改用户名弹窗 -->
<t-dialog
  visible="{{showEditDialog}}"
  title="修改用户名"
  confirm-btn="保存"
  cancel-btn="取消"
  bind:confirm="onConfirmEdit"
  bind:cancel="onCancelEdit"
>
  <view slot="content" style="padding: 20rpx 0;">
    <t-input
      value="{{editUsername}}"
      placeholder="请输入新的用户名"
      borderless="{{true}}"
      bind:change="onUsernameInput"
      style="background: #F2F2F7; border-radius: 16rpx; padding: 20rpx 32rpx; margin-top: 16rpx;"
      maxlength="20"
    />
  </view>
</t-dialog>
