<view class="container">
  <!-- 动态模糊背景 -->
  <view class="bg-blur-circle bg-azure"></view>
  <view class="bg-blur-circle bg-teal"></view>

  <!-- 顶部透明沉浸式背景 -->
  <view class="header-bg apple-header" style="padding-top: {{statusBarHeight + 12}}px; padding-left: 40rpx; padding-right: 40rpx; padding-bottom: 24rpx; display: flex; justify-content: space-between; align-items: flex-end;">
    <view class="title-group">
      <view class="page-title">全部设备</view>
      <view class="page-subtitle" style="font-size: 26rpx; color: #8E8E93; margin-top: 8rpx; font-weight: 500;">共 {{devices.length}} 个可用</view>
    </view>
    <!-- 右侧装饰性/功能性按钮 -->
    <view class="header-action" style="width: 64rpx; height: 64rpx; background: rgba(0,0,0,0.06); border-radius: 32rpx; display: flex; align-items: center; justify-content: center; margin-bottom: 8rpx;">
      <t-icon name="search" size="36rpx" color="#1c1c1e" />
    </view>
  </view>

  <!-- ========== 内容展示区 ========== -->
  <view class="list-wrapper">

      <!-- 加载中 -->
      <view class="loading-wrap" wx:if="{{loading}}">
        <t-loading theme="circular" size="40rpx" text="加载中..." />
      </view>

      <!-- 设备卡片列表 -->
      <block wx:elif="{{devices.length > 0}}">
        <view class="apple-card" wx:for="{{devices}}" wx:key="id" bindtap="onDeviceDetail" data-device="{{item}}" style="margin: 0 40rpx 32rpx; background: #FFF; border-radius: 32rpx; padding: 32rpx; box-shadow: 0 8rpx 32rpx rgba(0,0,0,0.03); border: 2rpx solid rgba(0,0,0,0.03);">
          <!-- 卡片头部 -->
          <view class="device-card-header" style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 32rpx;">
            <view class="device-title-row" style="display: flex; align-items: center; gap: 24rpx;">
              <view class="device-icon-wrap" style="width: 88rpx; height: 88rpx; border-radius: 28rpx; background: rgba(0,122,255,0.08); display: flex; align-items: center; justify-content: center;">
                <t-icon name="{{item.deviceType === 'alarm' ? 'notification' : item.deviceType === 'sensor' ? 'control-platform' : 'desktop'}}" size="48rpx" color="#007AFF" />
              </view>
              <view>
                <view class="device-name" style="font-size: 34rpx; font-weight: 600; color: #1C1C1E; margin-bottom: 6rpx;">{{item.deviceName || '未命名设备'}}</view>
                <view style="font-size: 24rpx; color: #8E8E93; font-family: monospace;">ID: {{item.deviceId}}</view>
              </view>
            </view>
            
            <view class="status-badge" style="display: flex; align-items: center; gap: 8rpx; padding: 8rpx 20rpx; border-radius: 24rpx; background: {{item.status === 1 ? 'rgba(52,199,89,0.1)' : 'rgba(255,59,48,0.1)'}};">
              <view class="status-dot" style="width: 12rpx; height: 12rpx; border-radius: 50%; background: {{item.status === 1 ? '#34C759' : '#FF3B30'}}; box-shadow: 0 0 8rpx {{item.status === 1 ? 'rgba(52,199,89,0.5)' : 'rgba(255,59,48,0.5)'}};"></view>
              <text style="font-size: 24rpx; font-weight: 600; color: {{item.status === 1 ? '#34C759' : '#FF3B30'}};">{{item.status === 1 ? '在线' : '离线'}}</text>
            </view>
          </view>

          <!-- 卡片信息区 -->
          <view class="device-info-grid" style="background: #F9F9F9; border-radius: 20rpx; padding: 24rpx; display: flex; gap: 16rpx; margin-bottom: 32rpx;">
            <view style="flex: 1; display: flex; flex-direction: column; gap: 8rpx;">
              <text style="font-size: 24rpx; color: #8E8E93;">类型</text>
              <text style="font-size: 28rpx; font-weight: 500; color: #333333;">{{item.deviceType || '通用终端'}}</text>
            </view>
            <view style="width: 2rpx; background: rgba(0,0,0,0.04); margin: 8rpx 0;"></view>
            <view style="flex: 1; display: flex; flex-direction: column; gap: 8rpx; padding-left: 16rpx;">
              <text style="font-size: 24rpx; color: #8E8E93;">位置分布</text>
              <text style="font-size: 28rpx; font-weight: 500; color: #333333;">{{item.location || '--'}}</text>
            </view>
          </view>
        </view>
      </block>

    <!-- 空状态 -->
    <view class="empty-wrap" wx:else>
      <t-empty icon="info-circle-filled" description="暂无设备" />
    </view>
  </view>
  <t-toast id="t-toast" />
  <t-dialog
    visible="{{showDeleteDialog}}"
    title="确认删除"
    content="确定要删除设备 {{deleteDeviceName}} 吗？此操作不可恢复。"
    confirm-btn="删除"
    cancel-btn="取消"
    bind:confirm="confirmDelete"
    bind:cancel="cancelDelete"
  />
</view>
